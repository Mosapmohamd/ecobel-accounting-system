# PostgreSQL connection string for production. If unset, falls back to a
# local SQLite file (ecobel_dev.db) — fine for development only.
#
# If you're running ecobel-website locally too and want it to see this
# service's data, point BOTH services' DATABASE_URL at the exact same
# file/database instead of leaving this unset — e.g.:
#   DATABASE_URL=sqlite:////absolute/path/to/shared/ecobel_shared_dev.db
DATABASE_URL=postgresql://ecobel_user:CHANGE_ME@localhost:5432/ecobel_db

# Used to sign login tokens — set to a long random value in production.
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# Comma-separated list of allowed frontend origins for CORS. Defaults to
# the local Vite dev server if unset — set this to your real deployed
# frontend URL(s) in production.
FRONTEND_ORIGINS=https://accounting.ecobel-eg.com
