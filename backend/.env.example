# PostgreSQL connection string for production. If unset, falls back to a
# local SQLite file (ecobel_dev.db) — fine for development only.
#
# If you're running ecobel-website locally too and want it to see this
# service's data, point BOTH services' DATABASE_URL at the exact same
# file/database instead of leaving this unset — e.g.:
#   DATABASE_URL=sqlite:////absolute/path/to/shared/ecobel_shared_dev.db
DATABASE_URL=postgresql://ecobel_user:CHANGE_ME@localhost:5432/ecobel_db

# Used to sign login tokens — set to a long random value in production.
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# Comma-separated list of allowed frontend origins for CORS. Defaults to
# the local Vite dev server if unset — set this to your real deployed
# frontend URL(s) in production.
FRONTEND_ORIGINS=https://accounting.ecobel-eg.com

# Product photos — Supabase Storage (see app/product_images.py).
# SUPABASE_URL is the project URL (not secret). SUPABASE_SECRET_KEY is the
# server-only secret key (Dashboard → Project Settings → API Keys); it must
# never appear in a frontend. Without both, photo uploads answer 503.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=
# PRODUCT_IMAGES_BUCKET=product-images
# PRODUCT_IMAGE_BASE_URL=   # optional: public base URL override (e.g. a CDN)

# "production" turns on strict mode: no public API docs (/docs, /openapi.json),
# HSTS, and startup is refused unless SECRET_KEY is a random value of 32+
# characters and FRONTEND_ORIGINS lists only https origins (no localhost).
# Behind a reverse proxy, run uvicorn with --proxy-headers
# --forwarded-allow-ips=<proxy address> so rate limits see each visitor's
# real address instead of the proxy's.
ENVIRONMENT=development
# (Safe proxy start command and every variable: docs/DEPLOYMENT.md.)

# Optional staff sign-in throttle (defaults shown; app/login_throttle.py):
# STAFF_LOGIN_MAX_FAILURES=10
# STAFF_LOGIN_FAILURE_WINDOW_MINUTES=15
# STAFF_LOGIN_BLOCK_MINUTES=15
